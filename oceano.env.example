# Oceano configuration reference
#
# Copy this file to `oceano.env`, uncomment only the settings you want to override, and
# protect it because it may contain credentials:
#   cp oceano.env.example oceano.env
#   chmod 600 oceano.env
#
# The systemd service reads `oceano.env` at startup. Restart Oceano after changing it.
# Values shown below are the application defaults unless a line explicitly says otherwise.

# =============================================================================
# Primary model and OpenAI-compatible endpoint
# =============================================================================

# Endpoint used when no endpoint is selected in Settings → Delegation.
# OCEANO_LLM_URL=http://127.0.0.1:8081/v1

# API key for that endpoint. llama.cpp ignores the default sentinel; use a real secret only
# for a remote authenticated endpoint. Never commit oceano.env.
# OCEANO_LLM_KEY=sk-no-key-needed

# Optional model-id pin for headless/development use. Empty lets Oceano resolve the selected
# primary model or an available River automatically.
# OCEANO_MODEL=

# Connection timeout, maximum idle gap during a response, and hidden SDK retry count.
# OCEANO_LLM_CONNECT_TIMEOUT=10
# OCEANO_LLM_TIMEOUT=300
# OCEANO_LLM_RETRIES=1

# =============================================================================
# Tool-schema loading (OFF/full-catalog by default)
# =============================================================================

# Practical default: keep the complete catalog globally. The qwen* rule in
# tool-loading.toml.example selectively enables hybrid loading for Qwen models.
# Hybrid starts with relevant capability bundles and a virtual discover_tools tool that can
# cumulatively load more schemas. It changes context size, never execution permissions.
OCEANO_TOOL_LOADING_MODE=full

# Approximate schema-token budget for the first model call and the maximum cumulative budget
# after discovery. These count serialized schema size (~characters/4), not merely tool count.
# OCEANO_TOOL_SCHEMA_BUDGET=5000
# OCEANO_TOOL_MAX_SCHEMA_BUDGET=9000

# Let hybrid-mode models call discover_tools to search/load more allowed capability bundles.
# OCEANO_TOOL_DISCOVERY=1

# Recovery after a model says a needed tool is unavailable or fails to act:
# none, discover-once (one larger relevant expansion), or full-once (relevant expansion,
# then one complete-allowed-catalog attempt). The default is full-once.
# OCEANO_TOOL_FALLBACK=full-once

# Structured policy file for the practical Qwen-only setup. Before starting Oceano, copy
# tool-loading.toml.example to tool-loading.toml. The active file is gitignored because
# deployments may differ; relative paths resolve from the service working directory.
OCEANO_TOOL_CONFIG=tool-loading.toml

# Internal handoff populated per resident turn by Oceano. It identifies the daemon-owned dynamic
# MCP catalog and shared call budget; users must not set or persist OCEANO_MCP_CATALOG manually.

# Compatibility settings for installations configured before the hybrid loader. Prefer the
# OCEANO_TOOL_* settings above for new deployments.
#
# 1 is equivalent to OCEANO_TOOL_LOADING_MODE=hybrid; 0 means full.
# OCEANO_DYNAMIC_TOOLS=0

# Legacy maximum advertised schema count (values below 8 are raised to 8). When present this
# remains a secondary cap in addition to the token budget.
# OCEANO_DYNAMIC_TOOL_LIMIT=18

# Optional comma-separated, case-insensitive shell-style model patterns. When set, routing
# applies only to matching models. Example: qwen*,llama-3.2-*,local-*
# Empty means every model is eligible when OCEANO_DYNAMIC_TOOLS=1.
# OCEANO_DYNAMIC_TOOL_MODELS=

# Optional model patterns that must always keep the full catalog. Exclusions win over includes.
# Example: gpt-*,claude-*,*-large
# OCEANO_DYNAMIC_TOOL_EXCLUDE_MODELS=

# Write content-free routing/runtime metrics to data/traces.jsonl: model/tool names, counts,
# bundles, schema tokens saved, fallbacks, tool/model-step budgets, timings, and error/side-effect
# counts. Prompts, arguments, results, and answers are never recorded.
# OCEANO_DYNAMIC_TOOL_TELEMETRY=1

# =============================================================================
# Workspace, agent limits, context, and learning
# =============================================================================

# Folder available to agent file/shell tools. Default: <Oceano repository>/workspace.
# OCEANO_WORKSPACE=/absolute/path/to/workspace

# Keep file tools confined to OCEANO_WORKSPACE. Disabling this materially increases risk.
# OCEANO_CONFINE=1

# Maximum model/tool-loop steps per agent turn. A model response may contain several tool calls.
# OCEANO_MAX_STEPS=25

# Separate cap on individual tool calls within one turn. 0/unset derives a compatibility-friendly
# ceiling of four calls per OCEANO_MAX_STEPS; set an explicit positive value for tighter control.
# For resident MCP tools this is enforced in the daemon before execution. Claude hybrid mode routes
# native file/shell work through that bridge; resident Codex blocks native mutations pre-execution.
# OCEANO_MAX_TOOL_CALLS=0

# Timeout for an individual shell command (seconds).
# OCEANO_SHELL_TIMEOUT=60

# Maximum concurrently running spawned agents.
# OCEANO_AGENTS_MAX=3

# Automatically extract durable user facts into memory after completed turns.
# OCEANO_AUTO_LEARN=1

# Fold old conversation history after this many characters; 0 disables automatic folding.
# Chunk size controls each summarization request and is clamped to at least 2000 characters.
# OCEANO_CTX_FOLD_CHARS=120000
# OCEANO_CTX_FOLD_CHUNK_CHARS=10000

# =============================================================================
# Safety and network controls
# =============================================================================

# Command and URL safety guards. Keep enabled unless debugging in an isolated environment.
# OCEANO_SHELL_GUARD=1
# OCEANO_URL_GUARD=1

# Shell sandbox: auto uses the supported local sandbox, 0 disables it. Workspace confinement
# and command safety checks still apply, but disabling the sandbox reduces defense in depth.
# OCEANO_SHELL_SANDBOX=auto

# Comma-separated internal/private hosts explicitly allowed for the http_request tool despite
# SSRF protection, e.g. homeassistant.local,192.168.1.20. Do not include URL schemes or paths.
# OCEANO_HTTP_ALLOW=

# =============================================================================
# Delegation and resident Claude/Codex minds
# =============================================================================

# No-output idle limit, total wall-clock limit, and maximum agent turns for delegated work.
# OCEANO_DELEGATE_IDLE=300
# OCEANO_DELEGATE_MAXTOTAL=3600
# OCEANO_DELEGATE_MAXTURNS=60

# Rate-limit retries and maximum server-requested wait accepted by a delegate (seconds).
# OCEANO_DELEGATE_RL_RETRIES=2
# OCEANO_DELEGATE_RL_WAIT=1800

# Optional explicit CLI paths. Empty uses the executable found on PATH.
# OCEANO_CLAUDE_BIN=/path/to/claude
# OCEANO_CODEX_BIN=/path/to/codex

# Optional Codex authentication directory to copy into the isolated per-turn Codex home.
# Leave empty to use the standard configured Codex home.
# OCEANO_CODEX_AUTH_HOME=

# Codex sandbox override. Leave empty for Oceano's selected default; accepted values must be
# supported by the installed Codex CLI (for example read-only or workspace-write). Resident Codex
# still installs a PreToolUse guard that routes native shell and mutations through Oceano MCP.
# OCEANO_CODEX_SANDBOX=

# More generous limits for unattended scheduled/workflow turns driven by a resident mind.
# 0 falls back to the interactive delegation limits above.
# OCEANO_MIND_BG_IDLE=900
# OCEANO_MIND_BG_MAXTOTAL=7200

# =============================================================================
# Local model, embedding, and reranking services
# =============================================================================

# llama.cpp checkout/build root and model directory. Fresh installs default to
# <Oceano repository>/llama.cpp and its models/ subdirectory; a legacy ~/llama.cpp is reused.
# OCEANO_LLAMA_DIR=/absolute/path/to/llama.cpp
# OCEANO_MODELS_DIR=/absolute/path/to/models

# llama-server executable and llama-swap configuration.
# OCEANO_LLAMA_SERVER_BIN=/absolute/path/to/llama-server
# OCEANO_LLAMA_SWAP_CFG=/absolute/path/to/llama-swap.yaml

# Installer-only llama-swap binary path (scripts/install.sh); not read by the running app.
# OCEANO_LLAMA_SWAP_BIN=/usr/local/bin/llama-swap

# Embedding model file used by the managed server and its OpenAI-compatible endpoint/model id.
# OCEANO_EMBED_MODEL=/absolute/path/to/nomic-embed-text-v1.5.Q8_0.gguf
# OCEANO_EMBED_URL=http://127.0.0.1:8082/v1

# 1 lets Oceano start/stop the embedding server; 0 means an external service manages it.
# OCEANO_EMBED_MANAGED=1

# Optional reranker model, endpoint, and managed-service switch.
# OCEANO_RERANK_MODEL=/absolute/path/to/bge-reranker-v2-m3-Q8_0.gguf
# OCEANO_RERANK_URL=http://127.0.0.1:8084
# OCEANO_RERANK_MANAGED=1

# Optional Hugging Face credential for gated model repositories. OCEANO_HF_TOKEN is preferred
# in this file; HF_TOKEN is accepted for compatibility with Hugging Face tooling.
# OCEANO_HF_TOKEN=
# HF_TOKEN=

# Docker build argument used by the installer/Dockerfile: cpu or vulkan. Not a runtime option.
# OCEANO_BACKEND=cpu

# =============================================================================
# Search, browser, and desktop interaction
# =============================================================================

# SearXNG base URL used by web_search.
# OCEANO_SEARXNG=http://127.0.0.1:8080

# Browser automation defaults: stealth patches, Accept-Language, and live screencast.
# OCEANO_BROWSER_STEALTH=1
# OCEANO_BROWSER_LANG=en-US,en;q=0.9
# OCEANO_BROWSER_SCREENCAST=1

# Unified outbound-web governor. Requests to one origin are serialized and their starts are
# spaced by this many seconds; total simultaneous operations across different origins are capped.
# OCEANO_WEB_MIN_INTERVAL=1.5
# OCEANO_WEB_MAX_CONCURRENCY=4

# Safe GET response cache/deduplication lifetime and maximum entries. Authenticated/private browser
# responses are excluded automatically. HTTP 403/429 cooldowns honor Retry-After up to MAX_COOLDOWN.
# OCEANO_WEB_CACHE_TTL=300
# OCEANO_WEB_CACHE_ENTRIES=256
# OCEANO_WEB_BLOCK_COOLDOWN=120
# OCEANO_WEB_MAX_COOLDOWN=3600

# Maximum retained per-origin pacing/cooldown records. Active operations are never evicted.
# OCEANO_WEB_MAX_ORIGIN_STATES=1024

# fetch_url preserves normal public browser rendering and page behavior while blocking every
# navigation/subresource to private, loopback, link-local, and metadata addresses. RENDER_WAIT is
# the maximum
# initial load wait in milliseconds (250-10000); the page remains live afterward. Research-mode
# tab opening expires after RESEARCH_TTL seconds so a past web_search does not arm future turns.
# OCEANO_BROWSER_RENDER_WAIT=3000
# OCEANO_BROWSER_RESEARCH_TTL=300

# Optional Chrome/Chromium executable override.
# OCEANO_REAL_CHROME=/path/to/chrome

# Shell used by the web terminal.
# OCEANO_SHELL=/bin/bash

# Preferred editor for CLI editing. If unset, Oceano also checks VISUAL and EDITOR, then nano.
# OCEANO_EDITOR=nano
# VISUAL=
# EDITOR=

# =============================================================================
# Web server, timezone, calendar, and notifications
# =============================================================================

# Web bind address and port. 127.0.0.1 is safest behind a local reverse proxy.
# OCEANO_WEB_HOST=127.0.0.1
# OCEANO_WEB_PORT=8800

# First-boot login password for user 'admin'. Leave unset and Oceano generates a random one on
# first start, prints it to the console/journal, and saves it 0600 to data/initial-password — there
# is deliberately NO shipped default credential. Set this only to inject a known value from a
# secret store / compose / CI. Either way you're forced to change it at first sign-in.
# OCEANO_INITIAL_PASSWORD=

# Application timezone (IANA name, e.g. Europe/Lisbon). OCEANO_TZ is preferred; TZ is used as
# a fallback by calendar code and standard libraries.
# OCEANO_TZ=
# TZ=

# Calendar feed refresh interval (seconds) and working-day bounds used for free-slot searches.
# OCEANO_CAL_SYNC=900
# OCEANO_CAL_DAY_START=09:00
# OCEANO_CAL_DAY_END=18:00

# ntfy fallback configuration for scheduled-task notifications. Settings → Notifications can
# override these. Topics on the public ntfy.sh service should be private and hard to guess.
# OCEANO_NTFY_URL=https://ntfy.sh
# OCEANO_NTFY_TOPIC=

# =============================================================================
# Telegram and voice
# =============================================================================

# Bot token from @BotFather and comma-separated numeric Telegram user IDs allowed to use it.
# Empty allowed list means nobody can use the bot.
# OCEANO_TELEGRAM_TOKEN=
# OCEANO_TELEGRAM_ALLOWED=

# Speech-to-text model/cache/device/compute mode for faster-whisper.
# OCEANO_STT_MODEL=base.en
# OCEANO_STT_DIR=<Oceano repository>/assets/whisper
# OCEANO_STT_DEVICE=cpu
# OCEANO_STT_COMPUTE=int8

# Text-to-speech engine: auto, kokoro, or piper; maximum characters spoken per reply.
# OCEANO_TTS_ENGINE=auto
# OCEANO_TTS_MAX_CHARS=2000

# Piper voice file.
# OCEANO_TTS_VOICE=<Oceano repository>/assets/voice/alan.onnx

# Kokoro assets, voice id, and playback speed.
# OCEANO_KOKORO_DIR=<Oceano repository>/assets/kokoro
# OCEANO_KOKORO_MODEL=<OCEANO_KOKORO_DIR>/kokoro-v1.0.int8.onnx
# OCEANO_KOKORO_VOICES=<OCEANO_KOKORO_DIR>/voices-v1.0.bin
# OCEANO_KOKORO_VOICE=af_heart
# OCEANO_KOKORO_SPEED=1.0

# Wake phrase required by hands-free voice mode (case-insensitive).
# OCEANO_WAKE_WORD=oceano

# =============================================================================
# Encryption at rest
# =============================================================================

# Optional base64-encoded 32-byte key for encrypting saved API keys, mail/SSH credentials, and
# calendar URLs. Normally leave empty: Oceano creates and protects oceano.env.key automatically.
# If explicitly supplied, back it up securely—changing or losing it makes existing secrets unreadable.
# OCEANO_DATA_KEY=

# =============================================================================
# Internal MCP bridge variables — normally DO NOT set these manually
# =============================================================================

# The resident Claude/Codex bridge creates these per turn. They select the local server, authenticate
# the bridge, associate tool results with a chat, and constrain contained sub-agents. Persistent
# manual values can cross-wire sessions or weaken isolation.
# OCEANO_MCP_URL=http://127.0.0.1:8800
# OCEANO_MCP_TOKEN=
# OCEANO_MCP_SESSION=
# OCEANO_MCP_BACKGROUND=
# OCEANO_MCP_CLIENT=
# OCEANO_MCP_SCOPE=

# Set internally for web-terminal child processes. Do not configure globally.
# OCEANO_TERMINAL=1

# CODEX_HOME is managed by Codex itself and by Oceano's isolated Codex launcher. Prefer
# OCEANO_CODEX_AUTH_HOME above instead of setting this globally for the service.
# CODEX_HOME=
