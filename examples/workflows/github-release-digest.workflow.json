{
  "name": "GitHub release digest",
  "description": "Fetch a repo's latest releases from the GitHub API, loop over them, and write a Markdown digest. Shows: http node, regex transform (strips the 'HTTP 200' status line so dotted paths work), foreach loop with {{item.field}} digging into each release's JSON, and loop aggregation at the done edge. Works unauthenticated on public repos; for private ones add a header 'Authorization: Bearer {{secret.GITHUB_TOKEN}}' on the http node and store the token via 🔑 Secrets.",
  "overlap": "skip",
  "input": {"enabled": true, "label": "GitHub repo (owner/name)", "placeholder": "owner/repo", "required": false, "default": "ggml-org/llama.cpp"},
  "triggers": [],
  "graph": {
    "nodes": [
      {"id": 1, "type": "trigger", "kind": "manual", "x": 40, "y": 180},
      {"id": 2, "type": "http", "method": "GET", "url": "https://api.github.com/repos/{{input}}/releases?per_page=3", "headers": {"Accept": "application/vnd.github+json"}, "body": "", "retries": 1, "x": 260, "y": 180},
      {"id": 3, "type": "transform", "mode": "regex", "source": "{{last}}", "text": "HTTP \\d+\\n(.*)", "x": 510, "y": 180},
      {"id": 4, "type": "loop", "over": "{{last}}", "as": "item", "x": 750, "y": 180},
      {"id": 5, "type": "transform", "mode": "template", "source": "", "text": "## {{item.name}} — {{item.tag_name}} ({{item.published_at}})\n\n{{item.body}}", "x": 750, "y": 340},
      {"id": 6, "type": "instruction", "text": "Below is a JSON list of Markdown sections, one per release: {{last}}\nWrite the final digest: a five-bullet “what changed” summary across all releases at the top, then each release section, tidied but not shortened.", "x": 1000, "y": 180},
      {"id": 7, "type": "tool", "tool": "write_file", "args": {"path": "digests/releases.md", "content": "{{last}}"}, "x": 1250, "y": 180},
      {"id": 8, "type": "tool", "tool": "notify", "args": {"title": "📦 Release digest", "message": "Digest for {{input}} saved — workspace/digests/releases.md"}, "x": 1480, "y": 180},
      {"id": 9, "type": "end", "x": 1710, "y": 180}
    ],
    "edges": [
      {"from": 1, "to": 2, "branch": null},
      {"from": 2, "to": 3, "branch": null},
      {"from": 3, "to": 4, "branch": null},
      {"from": 4, "to": 5, "branch": "loop"},
      {"from": 5, "to": 4, "branch": null},
      {"from": 4, "to": 6, "branch": "done"},
      {"from": 6, "to": 7, "branch": null},
      {"from": 7, "to": 8, "branch": null},
      {"from": 8, "to": 9, "branch": null}
    ]
  }
}
