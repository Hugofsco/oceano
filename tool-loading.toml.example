# Oceano tool-schema advertisement policy.
#
# Copy to tool-loading.toml and restart Oceano. The active file is gitignored. This controls
# schemas shown to models. Resident MCP catalogs also enforce that selected subset at execution;
# explicit workflow/delegate allowlists remain the outer hard boundary and always take precedence.
#
# Precedence: explicit allowlist > surface > first matching model rule > default/environment.

[default]
mode = "full"                   # non-Qwen models keep every enabled built-in + connected MCP tool
schema_budget = 5000            # approximate schema tokens on the first call
max_schema_budget = 9000        # cumulative ceiling after discover_tools
discovery = true
fallback = "full-once"          # "none", "discover-once", or "full-once"
ambiguous = "discover"          # "discover" keeps the bootstrap small; "full" is conservative
telemetry = true
core_bundles = ["core"]

# Model rules use case-insensitive shell patterns; the first match wins.
[[models]]
pattern = "qwen*"
mode = "hybrid"
schema_budget = 4200
max_schema_budget = 7600

[[models]]
pattern = "*-large"
mode = "full"

# Surface rules override model and default settings. Workflow mode stays inherited here;
# resident mode is explicitly hybrid below.
[surfaces.workflow]
# Workflows commonly provide explicit tool scopes, which bypass routing. This setting applies
# only to workflow agents without an explicit scope.
schema_budget = 6000


# Resident Claude/Codex minds use the same bundle router for their MCP body. Hybrid mode also
# routes Claude file/shell calls through the daemon so catalog and call budgets are enforced
# before execution. Native Codex calls are cancelled and recorded if they cross this catalog.
[surfaces.resident]
mode = "hybrid"
schema_budget = 3600
max_schema_budget = 7000
discovery = true
fallback = "full-once"
ambiguous = "discover"

# Override a built-in bundle or define a new one. Unknown/unavailable tool names are ignored.
# [bundles.project-management]
# description = "Read and update project-management issues"
# aliases = ["issue", "ticket", "project", "sprint"]
# Every nested `requires` group must contribute at least one request token. This distinguishes
# domain + intent (for example, reading a ticket from changing one) and avoids broad keyword hits.
# requires = [["issue", "ticket"], ["read", "list", "update", "close"]]
# `excludes` suppresses known semantic collisions even when aliases match.
# excludes = ["release"]
# tools = ["issues_list", "issue_read", "issue_update"]
# core = ["issues_list", "issue_read"]
